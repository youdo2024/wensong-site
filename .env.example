# ─────────────────────────────────────────────────────────────
# 問爽的官網 環境變數
#
# 這份是「完整清單」，不是精選。程式碼實際讀到的每一個變數都在這裡，
# 因為漏設的那一個，往往要等到有人付不了錢或收不到信才會被發現。
#
# 標記說明
#   [必填]  沒設會壞掉或退回不安全的預設值
#   [選填]  沒設就是功能關閉，其餘照常運作
#   [開關]  只有 0 / 1 兩種值
#
# 正式站請設在 Zeabur 的環境變數，不要寫進檔案（.env 已 gitignore）。
# ─────────────────────────────────────────────────────────────

# ── 基本 ──────────────────────────────────────────────────────
# [必填] Volume 掛載路徑。沒設會退回專案目錄下的 ./data，
#        那份資料在每次重新部署時會消失——筆記、逐字稿、訂單會全部不見。
DATA_DIR=/data
# [必填] 對外正式網址。金流回呼、信件連結、SEO canonical 都以此為準。
SITE_URL=https://www.wensong.tw

# ── 後台 ──────────────────────────────────────────────────────
# [必填] 後台登入密碼（第 1 段：單一密碼；第 2 段改成三個帳號後這個變成初始種子）。
ADMIN_PASSWORD=
# [必填] 後台 session 簽章金鑰（隨機長字串，例如 openssl rand -hex 32）。
ADMIN_SECRET=
# [選填] 會員（顧客登入）session 金鑰。規則同上。
MEMBER_SECRET=
# [選填] 對外聯絡信箱，顯示在條款頁與信件頁尾。沒設用 lib/brand.ts 的 hi@wensong.tw。
CONTACT_EMAIL=

# ── 寄信（SMTP）────────────────────────────────────────────────
# [必填] 沒設＝全站不寄任何信：訂單確認、每日備份信全部停擺，而且不會有錯誤，只是安靜地不寄。
#        用 hi@wensong.tw 的 Google Workspace 帳號：先開兩步驟驗證，再建立「應用程式密碼」。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hi@wensong.tw
SMTP_PASS=
MAIL_FROM=問爽的 WenSong <hi@wensong.tw>

# ── 金流：藍新（第 3 段接，程式尚未寫）────────────────────────
# NEWEBPAY_MERCHANT_ID=
# NEWEBPAY_HASH_KEY=
# NEWEBPAY_HASH_IV=
# NEWEBPAY_TEST=1

# ── 金流：綠界 ECPay（程式保留，問爽的不開）──────────────────
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_TEST=0

# ── 金流：TapPay／PayUni／LINE Pay（程式保留，全部不設＝關閉）──
TAPPAY_APP_ID=
TAPPAY_APP_KEY=
TAPPAY_PARTNER_KEY=
TAPPAY_MERCHANT_ID=
TAPPAY_SANDBOX=0
TAPPAY_3DS=1
PAYUNI_MERID=
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=
PAYUNI_ENV=prod
PAYUNI_INVOICE=0
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_SANDBOX=0

# ── 電子發票：光貿 Amego（沿用於悅商行同一組）────────────────
# [選填] 沒設＝走光貿測試環境，開出來的發票不是真的。
AMEGO_TAX_ID=
AMEGO_APP_KEY=

# ── 會員登入（第三方；程式保留，先不開）────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ── 其他串接 ──────────────────────────────────────────────────
# [選填] GA4 Measurement Protocol，用於伺服器端補送購買事件（評估 ID 在 components/Analytics.tsx）
GA_API_SECRET=
# [選填] Portaly：問爽的每月定額只外連頁面，不串 API，這三個留空
PORTALY_API_KEY=
PORTALY_API_HOST=
PORTALY_CALLBACK_SECRET=

# ── 審核用測試站（只在 review 那台設）────────────────────────
# REVIEW_SITE=1
# REVIEW_KEY=
# REVIEW_MAIL_TO=

# ── 本機 Tailscale 預覽才設，絕不進 Zeabur ───────────────────
# INSECURE_PREVIEW=1
